{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["node"],   // ← AJOUTE CETTE LIGNE
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
  "next-env.d.ts",
  "src/**/*.ts",
  "src/**/*.tsx",
  "src/declarations.d.ts",
  ".next/types/**/*.ts",
  ".next/dev/types/**/*.ts"
, "src/lib/supabase/client.ts", "src/app/[locale]/layout.tsx", "components/layout/ThemeToggle.tsx"],
"exclude": [
  "node_modules",
  "supabase"
]
}